set pagination off
set confirm off
STARTUP_EOF
    debugger_gdb_openmpi_inspector_prelude
}

debugger_attach_probe_command()
{
    emit "info inferiors\n"
}

debugger_attach_ok()
{
    attach_output_file=$1
    attach_pid=$2

    # "info inferiors" lists "process <pid>" only when gdb is actually attached
    # to a live inferior; a failed attach leaves gdb at its prompt with none.
    grep -Eq "process[[:space:]]+$attach_pid([[:space:]]|\$)" \
        "$attach_output_file" 2>/dev/null
}

debugger_find_frame_number()
{
    raw_file=$1
    function_name=$2

    awk -v function_name="$function_name" '
        { sub(/^(\(gdb\) )+/, "") }
        index($0, function_name) && match($0, /^#[0-9]+/) {
            frame = substr($0, RSTART + 1, RLENGTH - 1)
            print frame
            exit
        }
    ' "$raw_file"
}

debugger_parse_stack()
{
    raw_file=$1
    funcs_file=$2
    details_file=$3
    labels_file=$4

    : > "$funcs_file"
    : > "$details_file"
    : > "$labels_file"

    awk -v funcs_file="$funcs_file" \
        -v details_file="$details_file" \
        -v labels_file="$labels_file" '
        function trim(s)
        {
            sub(/^[[:space:]]*/, "", s)
            sub(/[[:space:]]*$/, "", s)
            return s
        }

        function strip_function(s)
        {
            s = trim(s)
            sub(/[[:space:]]+at[[:space:]].*/, "", s)
            sub(/[[:space:]]+from[[:space:]].*/, "", s)
            sub(/[[:space:]]+[+][[:space:]].*/, "", s)
            sub(/[[:space:]]+[+][0-9].*/, "", s)
            sub(/\(.*/, "", s)
            return trim(s)
        }

        function gdb_function(line, s)
        {
            s = line
            sub(/^[[:space:]]*#[0-9]+[[:space:]]*/, "", s)
            if (match(s, / in /)) {
                s = substr(s, RSTART + RLENGTH)
            } else {
                sub(/^0x[0-9a-fA-F]+[[:space:]]*/, "", s)
            }
            return strip_function(s)
        }

        function frame_location(line, location)
        {
            if (match(line, /[[:space:]]at[[:space:]][^[:space:]]+:[0-9][0-9]*/)) {
                location = substr(line, RSTART + 4, RLENGTH - 4)
                return trim(location)
            }

            return ""
        }

        # Buffer frames per thread block, trimming each block at main (frames
        # below main, such as __libc_start_main, are dropped as before).  The
        # block to report is chosen in END.
        function record_frame(function_name, detail,    location)
        {
            if ("" == function_name) {
                return
            }
            if (block_done[cur]) {
                return
            }
            location = frame_location(detail)
            ++nframe[cur]
            bfunc[cur, nframe[cur]] = function_name
            bdetail[cur, nframe[cur]] = trim(detail)
            if ("" == location) {
                blabel[cur, nframe[cur]] = function_name
            } else {
                blabel[cur, nframe[cur]] = function_name " (" location ")"
            }
            if ("main" == function_name) {
                has_main[cur] = 1
                block_done[cur] = 1
            }
        }

        {
            sub(/^(\(gdb\) )+/, "")
        }

        /^[[:space:]]*(Thread [0-9]+[[:space:]])/ {
            ++cur
            nframe[cur] = 0
            has_main[cur] = 0
            block_done[cur] = 0
            next
        }

        /^[[:space:]]*#[0-9]+[[:space:]]/ {
            if (0 == cur) {
                cur = 1
                nframe[cur] = 0
                has_main[cur] = 0
                block_done[cur] = 0
            }
            record_frame(gdb_function($0), $0)
            next
        }

        END {
            # Report the first thread block that reaches main (the application
            # main thread); fall back to the first block if none does.  With
            # -ascending that is normally block 1, but the main-seeking choice
            # keeps the report correct regardless of thread ordering.
            chosen = 0
            for (b = 1; b <= cur; b++) {
                if (has_main[b]) {
                    chosen = b
                    break
                }
            }
            if (0 == chosen) {
                chosen = 1
            }
            for (i = 1; i <= nframe[chosen]; i++) {
                print bfunc[chosen, i] >> funcs_file
                print bdetail[chosen, i] >> details_file
                print blabel[chosen, i] >> labels_file
            }
        }
    ' "$raw_file"
}

debugger_gdb_python_quote()
{
    printf "%s\n" "$1" |
        tr '\n' ' ' |
        sed -e 's/\\/\\\\/g' -e "s/'/\\\\'/g" -e "s/^/'/" -e "s/$/'/"
}

debugger_gdb_openmpi_inspector_prelude()
{
    cat <<'EOF'
python
import gdb

SM_FIFO_FREE = -2
FLAG_SINGLE_COPY = 1
FLAG_COMPLETE = 2
FLAG_SETUP_FBOX = 4

REQUEST_COMPLETED = 1
REQ_STATE = {0: 'INVALID', 1: 'INACTIVE', 2: 'ACTIVE', 3: 'CANCELLED'}

# mca_pml_base_request_type_t (pml_base_request_dbg.h), used by OB1.
MCA_PML_REQUEST = {0: 'NULL', 1: 'SEND', 2: 'RECV', 3: 'IPROBE', 4: 'PROBE',
                   5: 'IMPROBE', 6: 'MPROBE'}

# mca_pml_cm_request_type_t (pml_cm_request.h) and the concrete CM request
# struct for each value: (type name, is_heavy, is_send).
CM_REQ_TYPE = {0: 'SEND_HEAVY', 1: 'SEND_THIN', 2: 'RECV_HEAVY',
               3: 'RECV_THIN', 4: 'NULL'}
CM_SUBTYPE = {0: ('mca_pml_cm_hvy_send_request_t', True, True),
              1: ('mca_pml_cm_thin_send_request_t', False, True),
              2: ('mca_pml_cm_hvy_recv_request_t', True, False),
              3: ('mca_pml_cm_thin_recv_request_t', False, False)}

_ompi_pdb_offset_bits = None
_ompi_pdb_offset_mask = None

def ompi_pdb_offset_bits():
    global _ompi_pdb_offset_bits, _ompi_pdb_offset_mask
    if _ompi_pdb_offset_bits is None:
        try:
            if 8 == gdb.lookup_type('fifo_value_t').sizeof:
                _ompi_pdb_offset_bits, _ompi_pdb_offset_mask = 32, 0xffffffff
            else:
                _ompi_pdb_offset_bits, _ompi_pdb_offset_mask = 24, 0x00ffffff
        except gdb.error:
            _ompi_pdb_offset_bits, _ompi_pdb_offset_mask = 32, 0xffffffff
    return _ompi_pdb_offset_bits, _ompi_pdb_offset_mask

def ompi_pdb_comp():
    return gdb.parse_and_eval('mca_btl_sm_component')

def ompi_pdb_ep_array():
    return ompi_pdb_comp()['endpoints']

def ompi_pdb_rel2virt(offset):
    offset_bits, offset_mask = ompi_pdb_offset_bits()
    offset = int(offset)
    idx = (offset >> offset_bits) & 0xffff
    segbase = int(ompi_pdb_ep_array()[idx]['segment_base'])
    addr = (offset & offset_mask) + segbase
    hdr_t = gdb.lookup_type('mca_btl_sm_hdr_t').pointer()
    # Use parse_and_eval to construct the pointer so GDB uses the correct
    # pointer width for the target rather than the Python-default int width.
    return gdb.parse_and_eval('(mca_btl_sm_hdr_t *)0x%x' % addr), idx

def ompi_pdb_flagstr(f):
    f = int(f)
    parts = []
    if f & FLAG_SINGLE_COPY:
        parts.append('SINGLE_COPY')
    if f & FLAG_COMPLETE:
        parts.append('COMPLETE')
    if f & FLAG_SETUP_FBOX:
        parts.append('SETUP_FBOX')
    if f == 0:
        parts.append('INLINE/0')
    return '|'.join(parts) + ' (0x%x)' % f

def ompi_pdb_list_len(l):
    try:
        return int(l['opal_list_length'])
    except gdb.error:
        return -1

def ompi_pdb_find_waitall_frame():
    # Fast path: check the currently selected thread.  Wrap the unwind in the
    # same try/except the slow path uses, so a gdb.error from f.older() (e.g. a
    # thread whose stack cannot be fully unwound) does not escape the dump.
    try:
        f = gdb.newest_frame()
        while f is not None:
            if 'ompi_request_default_wait_all' in (f.name() or ''):
                return f
            f = f.older()
    except gdb.error:
        pass
    # Slow path: search all other threads (covers hybrid OpenMP+MPI programs).
    # On success, leaves the found thread selected so that callers can call
    # read_var() against the frame's register context.  On failure, restores
    # the original thread.
    orig_thread = gdb.selected_thread()
    for thr in gdb.selected_inferior().threads():
        if thr == orig_thread:
            continue
        try:
            thr.switch()
            f = gdb.newest_frame()
            while f is not None:
                if 'ompi_request_default_wait_all' in (f.name() or ''):
                    return f
                f = f.older()
        except gdb.error:
            pass
    if orig_thread and orig_thread.is_valid():
        orig_thread.switch()
    return None

def ompi_pdb_field(val, path):
    cur = val
    try:
        for p in path.split('.'):
            cur = cur[p]
        return str(cur)
    except gdb.error:
        return '<%s?>' % path

def ompi_pdb_btlsm_dump():
    try:
        c = ompi_pdb_comp()
    except gdb.error as e:
        print('btlsm_dump: sm BTL state unavailable (%s); '
              'is the sm BTL in use and are debug symbols loaded?' % e)
        return
    print('============================================================')
    npeers = None
    try:
        pi = gdb.parse_and_eval('opal_process_info')
        print('local_rank=%s node_rank=%s num_local_peers=%s' % (
            pi['my_local_rank'], pi['my_node_rank'], pi['num_local_peers']))
        npeers = int(pi['num_local_peers']) + 1
    except gdb.error:
        print('(opal_process_info unavailable)')

    try:
        fifo = c['my_fifo']
        head = int(fifo['fifo_head'])
        tail = int(fifo['fifo_tail'])
        print('my_fifo: head=%d tail=%d fbox_available=%s' % (
            head, tail, fifo['fbox_available']))

        print('--- incoming FIFO contents (what THIS rank has not yet consumed) ---')
        if head == SM_FIFO_FREE:
            print('  <empty>')
        else:
            _, offset_mask = ompi_pdb_offset_bits()
            n = 0
            cur = head
            while cur != SM_FIFO_FREE and n < 200:
                try:
                    hdr, owner = ompi_pdb_rel2virt(cur)
                    h = hdr.dereference()
                    print('  [%3d] off=0x%x owner_rank=%d flags=%s tag=%s len=%s next=%d' % (
                        n, cur & offset_mask, owner, ompi_pdb_flagstr(h['flags']),
                        h['tag'], h['len'], int(h['next'])))
                    cur = int(h['next'])
                except gdb.error as e:
                    print('  [%3d] <decode error: %s>' % (n, e))
                    break
                n += 1
            print('  total queued (capped 200): %d' % n)
    except gdb.error as e:
        print('  <FIFO unavailable: %s>' % e)

    print('--- fragment free lists (allocated) ---')
    for name in ('sm_frags_user', 'sm_frags_eager', 'sm_frags_max_send'):
        try:
            fl = c[name]
            alloc = int(fl['fl_num_allocated'])
            print('  %-18s fl_num_allocated=%d' % (name, alloc))
        except gdb.error as e:
            print('  %-18s <unavailable: %s>' % (name, e))

    if npeers is None:
        print('--- endpoints: (opal_process_info unavailable; skipping) ---')
    else:
        print('--- endpoints (pending sends / peer fifo head-tail) ---')
        eps = ompi_pdb_ep_array()
        for i in range(npeers):
            try:
                ep = eps[i]
                psr = int(ep['peer_smp_rank'])
                pend = ompi_pdb_list_len(ep['pending_frags'])
                pf = ep['fifo']
                if int(pf) != 0:
                    ph = int(pf['fifo_head'])
                    pt = int(pf['fifo_tail'])
                else:
                    ph = pt = 0
                fbo = 'fbox' if int(ep['fbox_out']['buffer']) != 0 else '----'
                print('  ep[%2d] peer=%2d pending_frags=%d peer_fifo(head=%d tail=%d) %s' % (
                    i, psr, pend, ph, pt, fbo))
            except gdb.error as e:
                print('  ep[%2d] <error: %s>' % (i, e))

    print('--- pending_endpoints list length = %d ---' %
          ompi_pdb_list_len(c['pending_endpoints']))
    print('============================================================')

def ompi_pdb_req_dump(arg=''):
    args = arg.split()
    if len(args) == 2:
        try:
            base = gdb.parse_and_eval(args[0])
            count = int(gdb.parse_and_eval(args[1]))
            req_t = gdb.lookup_type('ompi_request_t').pointer().pointer()
            requests = base.cast(req_t)
        except (gdb.error, ValueError) as e:
            print('req_dump: cannot evaluate args: %s' % e)
            return
    else:
        # find_waitall_frame may leave a different thread selected (hybrid
        # OpenMP+MPI).  Read and detach the values we need, then restore the
        # caller's thread in a finally so later 'frame'/'print'/'info locals'
        # commands still operate on the thread the user had selected.
        orig_thread = gdb.selected_thread()
        try:
            f = ompi_pdb_find_waitall_frame()
            if f is None:
                print('req_dump: no ompi_request_default_wait_all frame; '
                      'pass: req_dump <requests_ptr> <count>')
                return
            count = int(f.read_var('count'))
            requests = f.read_var('requests')
            requests.fetch_lazy()
        except (gdb.error, ValueError) as e:
            print('req_dump: cannot read wait_all frame: %s' % e)
            return
        finally:
            if orig_thread is not None and orig_thread.is_valid():
                orig_thread.switch()

    print('============================================================')
    print('req_dump: count=%d requests=%s' % (count, requests))
    incomplete = 0
    for i in range(count):
        try:
            r = requests[i]
            if int(r) == 0:
                print('  [%3d] <NULL request>' % i)
                incomplete += 1
                continue
            rd = r.dereference()
            comp = int(rd['req_complete'])
            state = int(rd['req_state'])
            if comp == REQUEST_COMPLETED:
                continue
            incomplete += 1
            st = rd['req_status']
            try:
                rtype = str(rd['req_type'])
            except gdb.error:
                rtype = '?'
            comp_s = {0: 'PENDING', 1: 'COMPLETED'}.get(comp, 'SYNC@0x%x' % comp)
            print('  [%3d] type=%s state=%s(%d) complete=%s '
                  'status{SOURCE=%s TAG=%s err=%s _ucount=%s _cancelled=%s}' % (
                      i, rtype, REQ_STATE.get(state, '?'), state, comp_s,
                      st['MPI_SOURCE'], st['MPI_TAG'], st['MPI_ERROR'],
                      st['_ucount'], st['_cancelled']))
        except gdb.error as e:
            print('  [%3d] <error: %s>' % (i, e))
    print('--- incomplete/non-completed requests: %d / %d ---' %
          (incomplete, count))
    print('============================================================')

def ompi_pdb_active_pml():
    # Name of the selected PML component ('ob1', 'cm', ...), or None.
    try:
        name = gdb.parse_and_eval(
            'mca_pml_base_selected_component.pmlm_version.mca_component_name')
        s = name.string()
        return s if s else None
    except gdb.error:
        return None

def ompi_pdb_pml_dump_ob1_globals():
    try:
        ob1 = gdb.parse_and_eval('mca_pml_ob1')
        for nm in ('send_pending', 'recv_pending', 'rdma_pending',
                   'pckt_pending', 'non_existing_communicator_pending'):
            try:
                print('  mca_pml_ob1.%-34s size=%s' % (
                    nm, ob1[nm]['opal_list_length']))
            except gdb.error:
                pass
        print('  mca_pml_ob1.enabled = %s' % ob1['enabled'])
    except gdb.error as e:
        print('  <mca_pml_ob1 unavailable: %s>' % e)

def ompi_pdb_pml_dump_cm_globals():
    # CM delegates matching/progress to the MTL, so there are no PML-level
    # pending lists; report the active MTL instead.
    try:
        mtl = gdb.parse_and_eval('ompi_mtl')
        print('  ompi_mtl = %s' % mtl)
    except gdb.error as e:
        print('  <ompi_mtl unavailable: %s>' % e)
        return
    try:
        mname = gdb.parse_and_eval(
            'ompi_mtl_base_selected_component'
            '->mtl_version.mca_component_name').string()
        print('  active MTL = %s' % mname)
    except gdb.error:
        pass
    try:
        print('  ompi_mtl.mtl_flags = %s' % mtl['mtl_flags'])
    except gdb.error:
        pass

def ompi_pdb_dump_ob1_send(i, r):
    try:
        sr_t = gdb.lookup_type('mca_pml_ob1_send_request_t').pointer()
    except gdb.error as e:
        print('  [%d] <cannot look up OB1 send type: %s>' % (i, e))
        return
    sr = r.cast(sr_t)
    print('  --- request[%d] @%s (OB1 send) ---' % (i, r))
    print('      req_pending        = %s' % ompi_pdb_field(sr, 'req_pending'))
    print('      req_state          = %s' % ompi_pdb_field(sr, 'req_state'))
    print('      req_lock           = %s' % ompi_pdb_field(sr, 'req_lock'))
    print('      req_pipeline_depth = %s' %
          ompi_pdb_field(sr, 'req_pipeline_depth'))
    print('      req_bytes_delivered= %s' %
          ompi_pdb_field(sr, 'req_bytes_delivered'))
    print('      req_rdma_cnt       = %s' % ompi_pdb_field(sr, 'req_rdma_cnt'))
    print('      bytes_packed       = %s' %
          ompi_pdb_field(sr, 'req_send.req_bytes_packed'))
    print('      send_mode          = %s' %
          ompi_pdb_field(sr, 'req_send.req_send_mode'))
    print('      peer/tag/seq       = %s / %s / %s' % (
        ompi_pdb_field(sr, 'req_send.req_base.req_peer'),
        ompi_pdb_field(sr, 'req_send.req_base.req_tag'),
        ompi_pdb_field(sr, 'req_send.req_base.req_sequence')))
    print('      pml_complete       = %s' %
          ompi_pdb_field(sr, 'req_send.req_base.req_pml_complete'))

def ompi_pdb_dump_ob1_recv(i, r):
    try:
        rr_t = gdb.lookup_type('mca_pml_ob1_recv_request_t').pointer()
    except gdb.error as e:
        print('  [%d] <cannot look up OB1 recv type: %s>' % (i, e))
        return
    rr = r.cast(rr_t)
    print('  --- request[%d] @%s (OB1 recv) ---' % (i, r))
    print('      req_pending        = %s' % ompi_pdb_field(rr, 'req_pending'))
    print('      req_match_received = %s' %
          ompi_pdb_field(rr, 'req_match_received'))
    print('      req_lock           = %s' % ompi_pdb_field(rr, 'req_lock'))
    print('      req_pipeline_depth = %s' %
          ompi_pdb_field(rr, 'req_pipeline_depth'))
    print('      req_bytes_received = %s' %
          ompi_pdb_field(rr, 'req_bytes_received'))
    print('      req_bytes_expected = %s' %
          ompi_pdb_field(rr, 'req_bytes_expected'))
    print('      req_rdma_cnt       = %s' % ompi_pdb_field(rr, 'req_rdma_cnt'))
    print('      peer/tag/seq       = %s / %s / %s' % (
        ompi_pdb_field(rr, 'req_recv.req_base.req_peer'),
        ompi_pdb_field(rr, 'req_recv.req_base.req_tag'),
        ompi_pdb_field(rr, 'req_recv.req_base.req_sequence')))
    print('      pml_complete       = %s' %
          ompi_pdb_field(rr, 'req_recv.req_base.req_pml_complete'))

def ompi_pdb_dump_ob1_request(i, r):
    try:
        base_t = gdb.lookup_type('mca_pml_base_request_t').pointer()
        btype = int(r.cast(base_t)['req_type'])
    except gdb.error as e:
        print('  [%d] <cannot read OB1 base request: %s>' % (i, e))
        return
    if btype == 1:        # MCA_PML_REQUEST_SEND
        ompi_pdb_dump_ob1_send(i, r)
    elif btype == 2:      # MCA_PML_REQUEST_RECV
        ompi_pdb_dump_ob1_recv(i, r)
    else:
        print('  --- request[%d] @%s is OB1 %s (no detailed decoder) ---'
              % (i, r, MCA_PML_REQUEST.get(btype, '?(%d)' % btype)))

def ompi_pdb_dump_cm_request(i, r):
    try:
        cm_t = gdb.lookup_type('mca_pml_cm_request_t').pointer()
    except gdb.error as e:
        print('  [%d] <cannot look up CM request type: %s>' % (i, e))
        return
    cr = r.cast(cm_t)
    try:
        ptype = int(cr['req_pml_type'])
    except gdb.error:
        ptype = -1
    print('  --- request[%d] @%s (CM %s) ---'
          % (i, r, CM_REQ_TYPE.get(ptype, '?(%d)' % ptype)))
    print('      req_pml_complete   = %s' % ompi_pdb_field(cr, 'req_pml_complete'))
    print('      req_free_called    = %s' % ompi_pdb_field(cr, 'req_free_called'))
    print('      req_comm           = %s' % ompi_pdb_field(cr, 'req_comm'))
    print('      req_datatype       = %s' % ompi_pdb_field(cr, 'req_datatype'))
    print('      req_staged         = %s' % ompi_pdb_field(cr, 'req_staged'))
    try:
        st = cr['req_ompi']['req_status']
        print('      status             = {SOURCE=%s TAG=%s err=%s '
              '_ucount=%s _cancelled=%s}' % (
                  st['MPI_SOURCE'], st['MPI_TAG'], st['MPI_ERROR'],
                  st['_ucount'], st['_cancelled']))
    except gdb.error:
        pass

    info = CM_SUBTYPE.get(ptype)
    if info is None:
        return
    tname, heavy, is_send = info
    try:
        cv = r.cast(gdb.lookup_type(tname).pointer())
    except gdb.error as e:
        print('      <cannot cast to %s: %s>' % (tname, e))
        return
    if is_send:
        print('      send_mode          = %s' %
              ompi_pdb_field(cv, 'req_send.req_send_mode'))
    if heavy:
        # Heavy requests keep an explicit copy of the envelope and buffer.
        print('      peer/tag/count     = %s / %s / %s' % (
            ompi_pdb_field(cv, 'req_peer'),
            ompi_pdb_field(cv, 'req_tag'),
            ompi_pdb_field(cv, 'req_count')))
        print('      req_blocking       = %s' % ompi_pdb_field(cv, 'req_blocking'))
    # The MTL request is the last member; its completion_callback symbol
    # identifies the CM/MTL path.  MTL-private state is appended beyond this
    # base and is not portably decodable here.
    print('      req_mtl.ompi_req   = %s' % ompi_pdb_field(cv, 'req_mtl.ompi_req'))
    print('      req_mtl.completion = %s' %
          ompi_pdb_field(cv, 'req_mtl.completion_callback'))

def ompi_pdb_pml_dump(arg=''):
    print('============================================================')
    pml = ompi_pdb_active_pml()
    print('  active PML = %s' % (pml if pml else '<unknown>'))
    if pml == 'ob1':
        ompi_pdb_pml_dump_ob1_globals()
    elif pml == 'cm':
        ompi_pdb_pml_dump_cm_globals()

    args = arg.split()
    if len(args) >= 2:
        # Explicit requests_ptr + count: bypass the wait_all frame, same
        # semantics as req_dump <requests_ptr> <count>.
        try:
            req_t = gdb.lookup_type('ompi_request_t').pointer().pointer()
            requests = gdb.parse_and_eval(args[0]).cast(req_t)
            count = int(gdb.parse_and_eval(args[1]))
        except gdb.error as e:
            print('pml_dump: cannot evaluate args: %s' % e)
            print('============================================================')
            return
        idxs = range(count)
    else:
        # As in req_dump, find_waitall_frame may select another thread; read
        # the values we need and restore the caller's thread in a finally.
        orig_thread = gdb.selected_thread()
        try:
            f = ompi_pdb_find_waitall_frame()
            if f is None:
                print('pml_dump: no wait_all frame found; '
                      'pass: pml_dump <requests_ptr> <count>')
                print('============================================================')
                return
            count = int(f.read_var('count'))
            requests = f.read_var('requests')
            requests.fetch_lazy()
        except (gdb.error, ValueError) as e:
            print('pml_dump: cannot read wait_all frame: %s' % e)
            print('============================================================')
            return
        finally:
            if orig_thread is not None and orig_thread.is_valid():
                orig_thread.switch()
        idxs = []
        for i in range(count):
            r = requests[i]
            if int(r) and int(r.dereference()['req_complete']) != 1:
                idxs.append(i)
                if len(idxs) >= 4:
                    break

    for i in idxs:
        try:
            r = requests[i]
            if int(r) == 0:
                print('  --- request[%d] <NULL> ---' % i)
                continue
            # Only PML requests carry PML send/recv state; a mixed wait array
            # can also hold collective/IO/generalized requests.
            try:
                otype = str(r['req_type'])
            except gdb.error:
                otype = '?'
            if 'OMPI_REQUEST_PML' not in otype:
                print('  --- request[%d] @%s is %s; not a PML request ---'
                      % (i, r, otype))
                continue
            if pml == 'ob1':
                ompi_pdb_dump_ob1_request(i, r)
            elif pml == 'cm':
                ompi_pdb_dump_cm_request(i, r)
            else:
                print('  --- request[%d] @%s: no request decoder for PML %r ---'
                      % (i, r, pml))
        except gdb.error as e:
            print('  [%d] <error: %s>' % (i, e))
    print('============================================================')
end
EOF
}

debugger_btlsm_dump_command()
{
    emit "python\nompi_pdb_btlsm_dump()\nend\n"
}

debugger_req_dump_command()
{
    arg=$(debugger_gdb_python_quote "${1-}")

    emit "python\nompi_pdb_req_dump(%s)\nend\n" "$arg"
}

debugger_pml_dump_command()
{
    arg=$(debugger_gdb_python_quote "${1-}")

    emit "python\nompi_pdb_pml_dump(%s)\nend\n" "$arg"
}
