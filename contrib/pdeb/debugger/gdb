debugger_available()
{
    command -v gdb >/dev/null 2>&1
}

debugger_marker_command()
{
    marker=$1

    emit "printf \"%s\\\\n\"\n" "$marker"
}

debugger_backtrace_command()
{
    # -ascending lists threads lowest-numbered first, so Thread 1 (the
    # application's main thread) comes first, matching lldb's "thread
    # backtrace all".  Without it gdb walks threads in descending order and the
    # parser would otherwise analyze a helper thread (PMIx/progress/async)
    # parked in epoll/poll instead of where the application is stuck.  The
    # parser additionally seeks the thread that reaches main, so an older gdb
    # that ignores the ordering still reports the right thread.
    emit "thread apply all -ascending bt\n"
}

debugger_current_backtrace_command()
{
    emit "bt\n"
}

debugger_select_frame_command()
{
    frame_number=$1

    emit "frame %s\n" "$frame_number"
}

debugger_start()
{
    pid=$1
    command_file=$2
    log_file=$3
    tail_pid_file=$4

    feeder_fifo="$tmpdir/$pid.feeder"
    mkfifo "$feeder_fifo"
    # Open the FIFO once, O_RDWR (non-blocking on a FIFO on Linux and macOS,
    # the primary supported platforms), and let tail and gdb inherit that
    # already-open descriptor (fd 9) rather than re-opening the path.  Because
    # nothing re-opens the path afterwards, the FIFO can be unlinked
    # immediately without racing the children's open() calls: the old code's
    # 'rm -f' could fire before a child's open(), making gdb's '<' fail with
    # ENOENT or tail's '>' silently create a regular file.  tail (fd 1 -> fd 9)
    # stays the persistent writer so gdb never sees EOF on its input.
    # 'tail -n +1 -f' feeds the command file from the beginning; plain
    # 'tail -f' prints only the last 10 lines first, which would truncate the
    # multi-line startup/prelude block if tail opens the file late under load.
    exec 9<>"$feeder_fifo"
    rm -f "$feeder_fifo"
    tail -n +1 -f "$command_file" >&9 9>&- 2>/dev/null &
    printf "%s\n" "$!" > "$tail_pid_file"
    gdb -nx -q -p "$pid" <&9 9>&- > "$log_file" 2>&1 &
    exec 9>&-
    printf "%s\n" "$!"
}

debugger_startup_commands()
{
