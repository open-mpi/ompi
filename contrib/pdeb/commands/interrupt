help()
{
    printf "  interrupt\n"
}

detailed_help()
{
    cat <<EOF
interrupt
  Send SIGINT to the selected debuggers to bring them back to their prompt,
  as the native gdb and lldb command of the same name does.  Use this after a
  command that resumed the process -- "continue", "next" or "finish" over a
  call that never returns.  A debugger that is running the process reads no
  further commands, so without this every later command for that PID waits
  out PDEB_TIMEOUT and then fails.
EOF
}

run()
{
    if [ 0 -lt $# ] && [ "help" = "$1" ] ; then
        detailed_help
        return 0
    fi

    require_selection || return 1

    interrupted=
    for pid in $selected_pids ; do
        interrupt_debugger_pid=$(pdeb_debugger_pid "$pid")
        if [ -z "$interrupt_debugger_pid" ] ; then
            printf "No debugger recorded for PID %s.\n" "$pid" >&2
            continue
        fi

        if ! kill -INT "$interrupt_debugger_pid" 2>/dev/null ; then
            printf "Could not signal the debugger for PID %s.\n" "$pid" >&2
            continue
        fi
        interrupted="$interrupted $pid"
    done

    if [ -z "$interrupted" ] ; then
        return 1
    fi

    printf "Interrupted:%s\n" "$interrupted"

    # A debugger back at its prompt reads the marker command the timed-out
    # command left queued, which clears that PID's pending marker.  Doing it
    # here tells the user now whether the interrupt worked, rather than
    # letting their next command discover it a full timeout later.
    for pid in $interrupted ; do
        if ! pdeb_drain_pending_markers "$pid" 50 ; then
            printf "PID %s did not return to its debugger prompt.\n" "$pid" >&2
        fi
    done
}
