# ABI specific make components

noinst_LTLIBRARIES += libmpiext_xcallbacks_abi.la libmpiext_xcallbacks_abi_profile.la

$(abi_interface_profile_sources): $(OMPI_BINDINGS_GENERATOR)


abi_interface_profile_sources = \
        op_create_x_abi_generated.c

libmpiext_xcallbacks_abi_la_SOURCES = \
        $(abi_interface_profile_sources) \
        $(ompi_HEADERS)

libmpiext_xcallbacks_abi_la_CPPFLAGS = -DOMPI_NO_MPI_PROTOTYPES -DOMPI_BUILD_MPI_PROFILING=0 -DOMPI_BUILD_STANDARD_ABI
libmpiext_xcallbacks_abi_la_LDFLAGS = -module -avoid-version
libmpiext_xcallbacks_abi_la_LIBADD = libmpiext_xcallbacks_abi_profile.la

libmpiext_xcallbacks_abi_profile_la_SOURCES = \
        $(abi_interface_profile_sources) \
        $(ompi_HEADERS)

libmpiext_xcallbacks_abi_profile_la_CPPFLAGS = -DOMPI_NO_MPI_PROTOTYPES -DOMPI_BUILD_MPI_PROFILING=1 -DOMPI_BUILD_STANDARD_ABI
libmpiext_xcallbacks_abi_profile_la_LDFLAGS = -module -avoid-version
