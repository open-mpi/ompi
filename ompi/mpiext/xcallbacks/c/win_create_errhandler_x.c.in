#include "ompi_config.h"
#include <stdio.h>

#include "ompi/mpi/c/bindings.h"
#include "ompi/runtime/params.h"
#include "ompi/win/win.h"
#include "ompi/errhandler/errhandler.h"
#include "ompi/mpiext/xcallbacks/c/mpiext_xcallbacks_c.h"
#if OMPI_ABI_SRC
#include "ompi/mpi/c/abi.h"
#include "ompi/mpi/c/abi_converters.h"
#include "ompi/mpiext/xcallbacks/c/abi_xcallbacks_c.h"
#endif

PROTOTYPE ERROR_CLASS win_create_errhandler_x(WIN_ERRHANDLER_FUNCTION_X function, USER_DESTRUCTOR_X destructor, VOID extra_state, ERRHANDLER_OUT errhandler)
{
    ompi_errhandler_t *new_errhandler;

    /* Error checking */

    if (MPI_PARAM_CHECK) {
        OMPI_ERR_INIT_FINALIZE(FUNC_NAME);
        if (NULL == function || NULL == errhandler) {
            return OMPI_ERRHANDLER_NOHANDLE_INVOKE(MPI_ERR_ARG,
                                          FUNC_NAME);
        }
    }

#if OMPI_ABI_SRC
    new_errhandler =
        ompi_errhandler_create_x(OMPI_ERRHANDLER_TYPE_WIN,
                                (ompi_errhandler_generic_handler_fn_t *) function,
                                OMPI_ERRHANDLER_LANG_C,
                                (ompi_errhandler_converter_fn_t*)ompi_convert_errhandler_args_intern_to_abi,
                                extra_state,
                                destructor);
#else
    new_errhandler =
        ompi_errhandler_create_x(OMPI_ERRHANDLER_TYPE_WIN,
                                (ompi_errhandler_generic_handler_fn_t *) function,
                                OMPI_ERRHANDLER_LANG_C,
                                NULL,
                                extra_state,
                                destructor);
#endif

    if (NULL == new_errhandler) {
        return OMPI_ERRHANDLER_NOHANDLE_INVOKE(MPI_ERR_INTERN, FUNC_NAME);
    }

    *errhandler = new_errhandler;
    return MPI_SUCCESS;
}
