#include "ompi_config.h"
#include <stdio.h>

#include "ompi/mpi/c/bindings.h"
#include "ompi/runtime/params.h"
#include "ompi/communicator/communicator.h"
#include "ompi/errhandler/errhandler.h"
#include "ompi/request/request.h"
#include "ompi/request/grequest.h"
#include "ompi/memchecker.h"

/* Non blocking status retrieval. Upon completion, the request(s) will
 * not be freed (unlike the test function). A subsequent call to test, wait
 * or free should be executed on the request(s).
 */
PROTOTYPE ERROR_CLASS request_get_status_all(INT count, REQUEST_CONST requests:count, INT_OUT flag,
                                             STATUS_OUT statuses:count)
{
    MEMCHECKER(
       int j;
       for (j = 0; j< count;  j++) {
           memchecker_request(&requests[j]);
       }
    );

    if( MPI_PARAM_CHECK ) {
        int rc = MPI_SUCCESS;

        OMPI_ERR_INIT_FINALIZE(FUNC_NAME);
        if (NULL == requests) {
            rc = MPI_ERR_REQUEST;
        } else {
            /* Need to cast the const away, since the request argument for most
            ** MPI functions invoking this functionality does not have the const
            ** argument
            */
            if(!ompi_request_check_same_instance((MPI_Request *)requests, count) ) {
                rc = MPI_ERR_REQUEST;
            }
        }
        if ((NULL == flag) || (count < 0)) {
            rc = MPI_ERR_ARG;
        }
        OMPI_ERRHANDLER_NOHANDLE_CHECK(rc, rc, FUNC_NAME);
    }

    if (OPAL_UNLIKELY(0 == count)) {
        *flag = true;
        return MPI_SUCCESS;
    }

    bool all_done;
    ompi_request_t *failed = NULL;

#if OPAL_ENABLE_PROGRESS_THREADS == 0
    bool do_it_once = true;
 recheck_request_status:
#endif

    opal_atomic_mb();
    int i;
    all_done = true;
    for (i = 0; i < count; i++) {
        if( (requests[i] == MPI_REQUEST_NULL) || (requests[i]->req_state == OMPI_REQUEST_INACTIVE) ) {
            continue;
        }
#if OPAL_ENABLE_FT_MPI
        /* As MPI_Testall, detect a request terminated by a process failure.
           A MPI_ANY_SOURCE receive that cannot complete is reported as
           pending, and remains active. */
        if( ompi_request_is_failed(requests[i]) &&
            MPI_ERR_PROC_FAILED_PENDING == requests[i]->req_status.MPI_ERROR ) {
            ompi_request_t *pending = requests[i];
            if (MPI_STATUSES_IGNORE != statuses) {
                OMPI_COPY_STATUS(&statuses[i], pending->req_status, true);
                statuses[i].MPI_ERROR = MPI_ERR_PROC_FAILED_PENDING;
            }
            *flag = false;
            if (MPI_SUCCESS != ompi_errhandler_request_invoke(1, &pending, FUNC_NAME,
                                                              MPI_ERR_PROC_FAILED_PENDING, false)) {
                return MPI_ERR_IN_STATUS;
            }
            return MPI_SUCCESS;
        }
#endif
        if( REQUEST_COMPLETE(requests[i]) ) {
            continue;
        }
        all_done = false;
        break;
    }

    if (!all_done) {
#if OPAL_ENABLE_PROGRESS_THREADS == 0
        if(do_it_once) {
            /* If we run the opal_progress then check the status of the
               request before leaving. We will call the opal_progress only
               once per call. */
            opal_progress();
            do_it_once = false;
            goto recheck_request_status;
        }
#endif
        *flag = false;
        return MPI_SUCCESS;
    }

    for (i = 0; i < count; i++) {
        if( (requests[i] == MPI_REQUEST_NULL) || (requests[i]->req_state == OMPI_REQUEST_INACTIVE) ) {
            if (MPI_STATUSES_IGNORE != statuses) {
                OMPI_COPY_STATUS(&statuses[i], ompi_status_empty, true);
            }
            continue;
        }
        /* If this is a generalized request, we *always* have to call
           the query function to get the status (MPI-2:8.2), even if
           the user passed STATUS_IGNORE. */
        if (OMPI_REQUEST_GEN == requests[i]->req_type) {
            ompi_grequest_invoke_query(requests[i], &requests[i]->req_status);
        }
        if (MPI_STATUSES_IGNORE != statuses) {
            OMPI_COPY_STATUS(&statuses[i], requests[i]->req_status, true);
        }
        if (MPI_SUCCESS != requests[i]->req_status.MPI_ERROR) {
            if (NULL == failed) {
                failed = requests[i];
            }
        }
    }

    *flag = true;
    if (NULL != failed) {
        /* As for MPI_Testall, even with MPI_STATUSES_IGNORE */
        if (MPI_SUCCESS != ompi_errhandler_request_invoke(1, &failed, FUNC_NAME, false)) {
            return MPI_ERR_IN_STATUS;
        }
    }
    return MPI_SUCCESS;
}
