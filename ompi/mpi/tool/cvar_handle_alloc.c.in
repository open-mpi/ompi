#include "ompi_config.h"

#include "ompi/mpi/tool/mpit-internal.h"

PROTOTYPE ERROR_CLASS cvar_handle_alloc (INT cvar_index, OBJ_HANDLE obj_handle,
                              CVAR_HANDLE_OUT handle, INT_OUT count)
{
    ompi_mpit_cvar_handle_t *new_handle;
    int rc = MPI_SUCCESS;

    if (!mpit_is_initialized ()) {
        return MPI_T_ERR_NOT_INITIALIZED;
    }

    if (MPI_PARAM_CHECK && (NULL == handle || NULL == count)) {
        return MPI_T_ERR_INVALID;
    }

    if (NULL != obj_handle) {
        if (ompit_obj_invalid(obj_handle)) {
            return MPI_T_ERR_INVALID_HANDLE;
        }
    }

    ompi_mpit_lock ();

    *handle = NULL;

    do {
        new_handle = (ompi_mpit_cvar_handle_t *) malloc (sizeof (ompi_mpit_cvar_handle_t));
        if (NULL == new_handle) {
            rc = MPI_T_ERR_MEMORY;
            break;
        }

        rc = mca_base_var_get(cvar_index, &new_handle->var);
        if (OPAL_SUCCESS != rc) {
            rc = ompit_var_index_error (rc);
            free (new_handle);
            break;
        }

        new_handle->bound_object = obj_handle;

        if (MCA_BASE_VAR_TYPE_STRING == new_handle->var->mbv_type) {
            /* The count is the maximum length of the string, including the
               terminating \0.  Make it large enough for the current value,
               and no smaller than an arbitrary minimum so that the value
               can grow a little.  MPI_T_cvar_read() truncates a value that
               has grown beyond the count since. */
            const mca_base_var_storage_t *value = NULL;
            size_t len = 0;

            /* Get the value the way MPI_T_cvar_read() does: a synonym's
               value is its original variable's */
            if (OPAL_SUCCESS == mca_base_var_get_value (cvar_index, &value, NULL, NULL)
                && NULL != value && NULL != value->stringval) {
                len = strlen (value->stringval);
            }

            if (len >= INT_MAX) {
                rc = MPI_T_ERR_INVALID;
                free (new_handle);
                break;
            }
            new_handle->count = ((int) len + 1 > OMPI_MPIT_CVAR_STRING_MIN_COUNT)
                                    ? (int) len + 1
                                    : OMPI_MPIT_CVAR_STRING_MIN_COUNT;
        } else {
            /* MCA only supports a single integer at this time. Change me if
               this assumption changes. */
            new_handle->count = 1;
        }
        *count = new_handle->count;

        *handle = (MPI_T_cvar_handle) new_handle;
    } while (0);

    ompi_mpit_unlock ();

    return rc;
}
