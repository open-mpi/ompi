/*
 * Test intent:
 *   Feed the MPI Forum ABI entry points edge-case arguments that once
 *   crashed inside the generated conversion prologues -- NULL output
 *   pointers, NULL INOUT handles, and a topology collective on a
 *   communicator without a topology.  Every call must return an error
 *   (any error: the exact class is implementation-specific) rather
 *   than segfault.  Error handlers are set to MPI_ERRORS_RETURN on
 *   both MPI_COMM_WORLD and MPI_COMM_SELF because implementations
 *   route no-handle errors to either.
 *
 *   Also feed zero-count arguments with non-NULL arrays, which are
 *   legal and must SUCCEED: the conversion prologue's zero-size
 *   allocation once read as out-of-memory and every such call
 *   returned MPI_ERR_NO_MEM.
 */
int ret = MPI_Init(&argc, &argv);
if (MPI_SUCCESS != ret) {
    return 1;
}
ret = MPI_Comm_set_errhandler(MPI_COMM_WORLD, MPI_ERRORS_RETURN);
if (MPI_SUCCESS != ret) {
    return 2;
}
ret = MPI_Comm_set_errhandler(MPI_COMM_SELF, MPI_ERRORS_RETURN);
if (MPI_SUCCESS != ret) {
    return 3;
}

/* NULL output pointers: must fail cleanly, not dereference. */
ret = MPI_Abi_get_version(NULL, NULL);
if (MPI_SUCCESS == ret) {
    fprintf(stderr, "ABI_FAIL:edge:abi_get_version_null\n");
    return 10;
}

/* NULL INOUT request handle: the generated wrapper prologue must not
 * dereference it; the implementation reports the invalid request. */
ret = MPI_Wait(NULL, MPI_STATUS_IGNORE);
if (MPI_SUCCESS == ret) {
    fprintf(stderr, "ABI_FAIL:edge:wait_null\n");
    return 11;
}

/* Neighborhood collective on a communicator without a topology: the
 * wrapper prologue sizes its conversion arrays from the neighbor
 * counts and once crashed here before the implementation could raise
 * MPI_ERR_TOPOLOGY. */
ret = MPI_Neighbor_alltoallw(NULL, NULL, NULL, NULL,
                             NULL, NULL, NULL, NULL, MPI_COMM_WORLD);
if (MPI_SUCCESS == ret) {
    fprintf(stderr, "ABI_FAIL:edge:neighbor_no_topology\n");
    return 13;
}

/* Zero-count calls with non-NULL arrays are legal no-ops and must
 * succeed; the request array exercises the INOUT handle-array
 * conversion prologue. */
MPI_Request zero_reqs[1] = { MPI_REQUEST_NULL };
ret = MPI_Waitall(0, zero_reqs, MPI_STATUSES_IGNORE);
if (MPI_SUCCESS != ret) {
    fprintf(stderr, "ABI_FAIL:edge:waitall_zero_count\n");
    return 15;
}

/* Same for an IN handle-array conversion: a zero-count struct
 * datatype is legal and must be constructible and freeable. */
int zero_lens[1] = { 0 };
MPI_Aint zero_disps[1] = { 0 };
MPI_Datatype zero_types[1] = { MPI_INT };
MPI_Datatype zero_struct = MPI_DATATYPE_NULL;
ret = MPI_Type_create_struct(0, zero_lens, zero_disps, zero_types,
                             &zero_struct);
if (MPI_SUCCESS != ret) {
    fprintf(stderr, "ABI_FAIL:edge:type_create_struct_zero_count\n");
    return 16;
}
ret = MPI_Type_free(&zero_struct);
if (MPI_SUCCESS != ret) {
    fprintf(stderr, "ABI_FAIL:edge:type_free_zero_struct\n");
    return 17;
}

ret = MPI_Finalize();
if (MPI_SUCCESS != ret) {
    return 14;
}
return 0;
