/*
 * Test intent:
 *   Exercise MPI_T event callback registration APIs when the
 *   implementation has an allocatable event registration.  A build with
 *   no event sources returns 77 so the runner records a stable
 *   mpit_events_unavailable skip.  If a registration exists, this probe
 *   validates info set/get, callback registration, dropped-handler
 *   registration, and registration-free callback cleanup.
 */
int provided = 0;
int ret = MPI_T_init_thread(MPI_THREAD_SINGLE, &provided);
if (MPI_T_ERR_NOT_SUPPORTED == ret) {
    return 77;
}
if (MPI_SUCCESS != ret) {
    return 1;
}
/* provided must be one of the ABI thread-level constants: an
 * implementation that passes its internal encoding through
 * unconverted fails here. */
if (MPI_THREAD_SINGLE != provided && MPI_THREAD_FUNNELED != provided &&
    MPI_THREAD_SERIALIZED != provided && MPI_THREAD_MULTIPLE != provided) {
    fprintf(stderr, "ABI_FAIL:mpit:init_thread_provided:%d\n", provided);
    return 90;
}

/* Same for the verbosity and scope values reported by cvar_get_info:
 * they must be the ABI encodings, not internal enums.  Check the
 * first control variable whose query succeeds; zero cvars is
 * tolerated. */
{
    int num_cvar = 0;
    if (MPI_SUCCESS == MPI_T_cvar_get_num(&num_cvar)) {
        for (int ci = 0; ci < num_cvar; ++ci) {
            char cname[256];
            int cname_len = sizeof(cname);
            char cdesc[256];
            int cdesc_len = sizeof(cdesc);
            int cverb = -1;
            int cbind = -1;
            int cscope = -1;
            MPI_Datatype cdt = MPI_DATATYPE_NULL;
            MPI_T_enum cenum = MPI_T_ENUM_NULL;
            if (MPI_SUCCESS != MPI_T_cvar_get_info(ci, cname, &cname_len,
                                                   &cverb, &cdt, &cenum,
                                                   cdesc, &cdesc_len,
                                                   &cbind, &cscope)) {
                continue;
            }
            if (MPI_T_VERBOSITY_USER_BASIC != cverb &&
                MPI_T_VERBOSITY_USER_DETAIL != cverb &&
                MPI_T_VERBOSITY_USER_ALL != cverb &&
                MPI_T_VERBOSITY_TUNER_BASIC != cverb &&
                MPI_T_VERBOSITY_TUNER_DETAIL != cverb &&
                MPI_T_VERBOSITY_TUNER_ALL != cverb &&
                MPI_T_VERBOSITY_MPIDEV_BASIC != cverb &&
                MPI_T_VERBOSITY_MPIDEV_DETAIL != cverb &&
                MPI_T_VERBOSITY_MPIDEV_ALL != cverb) {
                fprintf(stderr, "ABI_FAIL:mpit:cvar_verbosity:%d\n", cverb);
                return 91;
            }
            if (MPI_T_SCOPE_CONSTANT != cscope &&
                MPI_T_SCOPE_READONLY != cscope &&
                MPI_T_SCOPE_LOCAL != cscope &&
                MPI_T_SCOPE_GROUP != cscope &&
                MPI_T_SCOPE_GROUP_EQ != cscope &&
                MPI_T_SCOPE_ALL != cscope &&
                MPI_T_SCOPE_ALL_EQ != cscope) {
                fprintf(stderr, "ABI_FAIL:mpit:cvar_scope:%d\n", cscope);
                return 92;
            }
            break;
        }
    }
}

int num_events = 0;
ret = MPI_T_event_get_num(&num_events);
if (MPI_SUCCESS != ret || num_events < 1) {
    (void) MPI_T_finalize();
    return 77;
}

mpit_event_state.registration = (MPI_T_event_registration) 0;
mpit_event_state.event_calls = 0;
mpit_event_state.dropped_calls = 0;
mpit_event_state.free_calls = 0;
mpit_event_state.failure_code = 0;

for (int event_index = 0; event_index < num_events; ++event_index) {
    char name[MPI_MAX_OBJECT_NAME];
    int name_len = (int) sizeof(name);
    int verbosity = 0;
    MPI_Datatype datatypes[4];
    MPI_Aint displacements[4];
    int num_elements = 4;
    MPI_T_enum enumtype = MPI_T_ENUM_NULL;
    MPI_Info info = MPI_INFO_NULL;
    char desc[MPI_MAX_INFO_VAL];
    int desc_len = (int) sizeof(desc);
    int bind = MPI_T_BIND_NO_OBJECT;

    ret = MPI_T_event_get_info(event_index, name, &name_len, &verbosity,
                               datatypes, displacements, &num_elements,
                               &enumtype, &info, desc, &desc_len, &bind);
    if (MPI_SUCCESS != ret) {
        continue;
    }
    if (MPI_INFO_NULL != info) {
        (void) MPI_Info_free(&info);
    }
    if (MPI_T_BIND_NO_OBJECT != bind) {
        continue;
    }

    ret = MPI_T_event_handle_alloc(event_index, NULL, MPI_INFO_NULL,
                                   &mpit_event_state.registration);
    if (MPI_SUCCESS == ret &&
        (MPI_T_event_registration) 0 != mpit_event_state.registration) {
        break;
    }
}

if ((MPI_T_event_registration) 0 == mpit_event_state.registration) {
    (void) MPI_T_finalize();
    return 77;
}

MPI_Info info = MPI_INFO_NULL;
ret = MPI_Info_create(&info);
if (MPI_SUCCESS != ret || MPI_INFO_NULL == info) {
    (void) MPI_T_event_handle_free(mpit_event_state.registration,
                                   &mpit_event_state,
                                   mpit_free_callback);
    (void) MPI_T_finalize();
    return 2;
}

MPI_Info used = MPI_INFO_NULL;
#define ABI_MPIT_CLEANUP_RETURN(code_)                                 \
    do {                                                               \
        if (MPI_INFO_NULL != used) {                                   \
            (void) MPI_Info_free(&used);                               \
        }                                                              \
        if (MPI_INFO_NULL != info) {                                   \
            (void) MPI_Info_free(&info);                               \
        }                                                              \
        if ((MPI_T_event_registration) 0 !=                            \
            mpit_event_state.registration) {                           \
            (void) MPI_T_event_handle_free(                            \
                mpit_event_state.registration, &mpit_event_state,       \
                mpit_free_callback);                                   \
        }                                                              \
        (void) MPI_T_finalize();                                       \
        return (code_);                                                \
    } while (0)

/* MPI_T_event_callback_{set,get}_info operate on the callback that is
   registered for a given cb_safety level, so the callback has to be
   registered first: setting info for a level that has no callback
   yet is an invalid handle. */
ret = MPI_T_event_register_callback(mpit_event_state.registration,
                                    MPI_T_CB_REQUIRE_NONE, info,
                                    &mpit_event_state,
                                    mpit_event_callback);
if (MPI_SUCCESS != ret) {
    ABI_MPIT_CLEANUP_RETURN(6);
}
ret = MPI_T_event_set_dropped_handler(mpit_event_state.registration,
                                      mpit_dropped_callback);
if (MPI_SUCCESS != ret) {
    ABI_MPIT_CLEANUP_RETURN(7);
}

ret = MPI_T_event_callback_set_info(mpit_event_state.registration,
                                    MPI_T_CB_REQUIRE_NONE, info);
if (MPI_SUCCESS != ret) {
    ABI_MPIT_CLEANUP_RETURN(3);
}

ret = MPI_T_event_callback_get_info(mpit_event_state.registration,
                                    MPI_T_CB_REQUIRE_NONE, &used);
if (MPI_SUCCESS != ret || MPI_INFO_NULL == used) {
    ABI_MPIT_CLEANUP_RETURN(4);
}
ret = MPI_Info_free(&used);
if (MPI_SUCCESS != ret || MPI_INFO_NULL != used) {
    if (MPI_SUCCESS == ret) {
        used = MPI_INFO_NULL;
    }
    ABI_MPIT_CLEANUP_RETURN(5);
}

ret = MPI_Info_free(&info);
if (MPI_SUCCESS != ret || MPI_INFO_NULL != info) {
    if (MPI_SUCCESS == ret) {
        info = MPI_INFO_NULL;
    }
    ABI_MPIT_CLEANUP_RETURN(8);
}

ret = MPI_T_event_handle_free(mpit_event_state.registration,
                              &mpit_event_state, mpit_free_callback);
if (MPI_SUCCESS != ret || 0 != mpit_event_state.failure_code ||
    1 != mpit_event_state.free_calls) {
    (void) MPI_T_finalize();
    return 9;
}

/*
 * Open MPI currently has no event sources that can fire this callback
 * in local CI.  Registration, dropped-handler, and free conversion were
 * exercised above, but the callback-invocation conversion path was not.
 * Return the distinct registration-only skip code (78) rather than the
 * generic "unavailable" 77 so the suite records that this probe covered
 * only registration/free and never the event-callback argument
 * conversion, instead of counting it as full MPI_T event coverage.
 */
if (0 == mpit_event_state.event_calls) {
    (void) MPI_T_finalize();
    return 78;
}

#undef ABI_MPIT_CLEANUP_RETURN

ret = MPI_T_finalize();
if (MPI_SUCCESS != ret) {
    return 10;
}
