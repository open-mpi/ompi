/*
 * Test intent:
 *   Validate end-to-end MPI_T event payload encoding for MPI_Session_init.
 *   The initialization event callback is registered via MPI_T_event_register_callback
 *   before MPI_Session_init, and the test verifies that the initialization event
 *   payload carries correct Standard-ABI session handle and thread_level values.
 */

/* Initialize MPI_T first so we can register callbacks before MPI_Session_init. */
int provided = 0;
int ret = MPI_T_init_thread(MPI_THREAD_SINGLE, &provided);
if (MPI_T_ERR_NOT_SUPPORTED == ret) {
    return 77;
}
if (MPI_SUCCESS != ret) {
    return 1;
}

/* Locate the initialization event by name. */
int num_events = 0;
ret = MPI_T_event_get_num(&num_events);
if (MPI_SUCCESS != ret || num_events < 1) {
    (void) MPI_T_finalize();
    return 77;
}

int initialization_index = -1;
for (int event_index = 0; event_index < num_events; ++event_index) {
    char name[MPI_MAX_OBJECT_NAME];
    int name_len = (int) sizeof(name);
    int verbosity = 0;
    MPI_Datatype datatypes[5];
    MPI_Aint displacements[5];
    int num_elements = 5;
    MPI_T_enum enumtype = MPI_T_ENUM_NULL;
    MPI_Info info = MPI_INFO_NULL;
    char desc[MPI_MAX_INFO_VAL];
    int desc_len = (int) sizeof(desc);
    int bind = MPI_T_BIND_NO_OBJECT;

    ret = MPI_T_event_get_info(event_index, name, &name_len, &verbosity,
                               datatypes, displacements, &num_elements,
                               &enumtype, &info, desc, &desc_len, &bind);
    if (MPI_SUCCESS != ret) {
        continue;
    }
    if (MPI_INFO_NULL != info) {
        (void) MPI_Info_free(&info);
    }
    if (NULL != strstr(name, "initialization")) {
        initialization_index = event_index;
        break;
    }
}

if (initialization_index < 0) {
    (void) MPI_T_finalize();
    return 77;
}

/* Register the initialization event callback before MPI_Session_init. */
mpit_initialization_state.registration = (MPI_T_event_registration) 0;
mpit_initialization_state.calls = 0;
mpit_initialization_state.failure_code = 0;
mpit_initialization_state.instance_id = 0;
mpit_initialization_state.model = -1;
mpit_initialization_state.thread_level = -1;

ret = MPI_T_event_handle_alloc(initialization_index, NULL, MPI_INFO_NULL,
                               &mpit_initialization_state.registration);
if (MPI_SUCCESS != ret ||
    (MPI_T_event_registration) 0 == mpit_initialization_state.registration) {
    (void) MPI_T_finalize();
    return 77;
}

ret = MPI_T_event_register_callback(mpit_initialization_state.registration,
                                    MPI_T_CB_REQUIRE_NONE, MPI_INFO_NULL,
                                    &mpit_initialization_state,
                                    mpit_initialization_callback);
if (MPI_SUCCESS != ret) {
    (void) MPI_T_event_handle_free(mpit_initialization_state.registration,
                                   NULL, NULL);
    (void) MPI_T_finalize();
    return 2;
}

/* Now call MPI_Session_init, which should trigger the initialization event. */
MPI_Session session = MPI_SESSION_NULL;
ret = MPI_Session_init(MPI_INFO_NULL, MPI_ERRORS_RETURN, &session);
if (MPI_SUCCESS != ret || MPI_SESSION_NULL == session) {
    (void) MPI_T_event_handle_free(mpit_initialization_state.registration,
                                   NULL, NULL);
    (void) MPI_T_finalize();
    return 1;
}

/* Verify the initialization event fired with the correct data. */
int local_failure = 0;
if (0 != mpit_initialization_state.failure_code) {
    local_failure = 3;
} else if (mpit_initialization_state.calls < 1) {
    local_failure = 4;
} else if (0 == mpit_initialization_state.instance_id) {
    /* The instance_id should be non-zero; 0 would indicate the old stub
       behavior or a missing converter. */
    fprintf(stderr, "ABI_FAIL:mpit:session_instance_id:0\n");
    local_failure = 5;
} else if (1 != mpit_initialization_state.model) {
    /* The model should be 1 (OMPI_T_MODEL_SESSION) for MPI_Session_init. */
    fprintf(stderr, "ABI_FAIL:mpit:session_model:%d:expected_1\n",
            mpit_initialization_state.model);
    local_failure = 6;
} else if (mpit_initialization_state.thread_level != MPI_THREAD_SINGLE) {
    /* The thread_level should be MPI_THREAD_SINGLE, requested from MPI_Session_init.
       If this fails, the value was not converted via ompi_mpit_abi_thread_level(). */
    fprintf(stderr, "ABI_FAIL:mpit:session_thread_level:%d:expected_%d\n",
            mpit_initialization_state.thread_level, MPI_THREAD_SINGLE);
    local_failure = 7;
}

ret = MPI_Session_finalize(&session);
if (MPI_SUCCESS != ret && 0 == local_failure) {
    local_failure = 8;
}

ret = MPI_T_event_handle_free(mpit_initialization_state.registration, NULL, NULL);
if (MPI_SUCCESS != ret && 0 == local_failure) {
    local_failure = 9;
}

ret = MPI_T_finalize();
if (MPI_SUCCESS != ret && 0 == local_failure) {
    local_failure = 10;
}

if (0 != local_failure) {
    return local_failure;
}
