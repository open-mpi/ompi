/*
 * Test intent:
 *   Verify that MPI_Session_init properly registers the MPI_T ABI handle
 *   converters when MPI_T callbacks are registered pre-init.  This validates
 *   the converter registration code in the MPI_Session_init path
 *   (open-mpi/ompi#13280).  The initialization event must fire with the
 *   Standard-ABI session handle, not zero or an internal pointer.
 *
 *   MPI_T_init_thread is called before MPI_Session_init, and the
 *   initialization event callback is registered before MPI_Session_init is
 *   called.  This ensures the converter registration in MPI_Session_init
 *   actually runs.
 */
struct mpit_initialization_state {
    MPI_T_event_registration registration;
    int calls;
    int failure_code;
    uint64_t instance_id;
    int32_t model;
};

static struct mpit_initialization_state mpit_initialization_state;

static void mpit_initialization_callback(MPI_T_event_instance event_instance,
                                         MPI_T_event_registration event_registration,
                                         MPI_T_cb_safety cb_safety,
                                         void *user_data)
{
    struct mpit_initialization_state *state =
        (struct mpit_initialization_state *) user_data;
    if (&mpit_initialization_state != state) {
        mpit_initialization_state.failure_code = 101;
    } else if (event_registration != state->registration) {
        state->failure_code = 102;
    } else if (MPI_T_CB_REQUIRE_NONE != cb_safety) {
        state->failure_code = 103;
    } else {
        ++state->calls;
        /* Element 0 of the initialization payload is the model (0 = world,
           1 = session), element 4 is instance_id. */
        (void) MPI_T_event_read(event_instance, 0, &state->model);
        (void) MPI_T_event_read(event_instance, 4, &state->instance_id);
    }
}
